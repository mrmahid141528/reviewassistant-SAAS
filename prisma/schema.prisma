generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  status        String    @default("active") // active/suspended/deleted
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts       Account[]
  sessions       Session[]
  memberships    BusinessMember[]
  adminSessions  AdminSession[]
  securityEvents SecurityEvent[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String?
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Business {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  category   String?
  settings   Json?
  logoUrl    String?  @map("logo_url")
  websiteUrl String?  @map("website_url")
  phone      String?
  email      String?
  timezone   String?
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  razorpayCustomerId       String?   @map("razorpay_customer_id")
  razorpaySubscriptionId   String?   @map("razorpay_subscription_id")
  razorpayPlanId           String?   @map("razorpay_plan_id")
  razorpayCurrentPeriodEnd DateTime? @map("razorpay_current_period_end")

  members             BusinessMember[]
  locations           BusinessLocation[]
  customers           Customer[]
  campaigns           Campaign[]
  feedbackSubmissions FeedbackSubmission[]
  reviewRequests      ReviewRequest[]
  generatedReviews    GeneratedReview[]
  googleIntegrations  GoogleIntegration[]
  subscriptions       Subscription[]
  payments            Payment[]
  usageRecords        UsageRecord[]
  auditLogs           AuditLog[]
  couponRedemptions   CouponRedemption[]

  @@map("businesses")
}

model BusinessMember {
  id         String    @id @default(uuid())
  businessId String    @map("business_id")
  locationId String?   @map("location_id")
  userId     String    @map("user_id")
  role       String    @default("staff") // owner/admin/manager/staff
  status     String    @default("invited")
  joinedAt   DateTime? @map("joined_at")
  createdAt  DateTime  @default(now()) @map("created_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)
  user     User              @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("business_members")
}

model BusinessLocation {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  name             String
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?  @map("postal_code")
  phone            String?
  googlePlaceId    String?  @map("google_place_id")
  googleBusinessId String?  @map("google_business_id")
  reviewLink       String?  @map("review_link")
  status           String   @default("active")
  isMain           Boolean  @default(false) @map("is_main")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers          Customer[]
  members            BusinessMember[]
  campaigns          Campaign[]
  reviewRequests     ReviewRequest[]
  googleIntegrations GoogleIntegration[]

  @@map("business_locations")
}

model Customer {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  locationId        String?  @map("location_id")
  name              String?
  email             String?
  phone             String?
  externalReference String?  @map("external_reference")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location            BusinessLocation?    @relation(fields: [locationId], references: [id])
  feedbackSubmissions FeedbackSubmission[]
  reviewRequests      ReviewRequest[]
  generatedReviews    GeneratedReview[]

  @@map("customers")
}

model Campaign {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  locationId      String?  @map("location_id")
  name            String
  slug            String
  status          String   @default("active")
  ratingThreshold Int      @default(4) @map("rating_threshold")
  reviewPlatform  String   @default("google") @map("review_platform")
  settings        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location            BusinessLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  questions           CampaignQuestion[]
  feedbackSubmissions FeedbackSubmission[]

  @@map("campaigns")
}

model CampaignQuestion {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  question     String
  questionType String   @map("question_type") // rating, text, etc
  options      Json?
  required     Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  campaign Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers  FeedbackAnswer[]

  @@map("campaign_questions")
}

model FeedbackSubmission {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  campaignId  String   @map("campaign_id")
  customerId  String?  @map("customer_id")
  rating      Int
  status      String   @default("completed")
  source      String?
  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign Campaign          @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer Customer?         @relation(fields: [customerId], references: [id], onDelete: SetNull)
  answers  FeedbackAnswer[]
  reviews  GeneratedReview[]
  requests ReviewRequest[]

  @@map("feedback_submissions")
}

model FeedbackAnswer {
  id                   String   @id @default(uuid())
  feedbackSubmissionId String   @map("feedback_submission_id")
  questionId           String   @map("question_id")
  answerText           String?  @map("answer_text")
  answerValue          Json?    @map("answer_value")
  createdAt            DateTime @default(now()) @map("created_at")

  submission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  question   CampaignQuestion   @relation(fields: [questionId], references: [id])

  @@map("feedback_answers")
}

model ReviewRequest {
  id                   String    @id @default(uuid())
  businessId           String    @map("business_id")
  locationId           String    @map("location_id")
  customerId           String?   @map("customer_id")
  feedbackSubmissionId String    @map("feedback_submission_id")
  platform             String    @default("google")
  status               String    @default("pending")
  reviewUrl            String?   @map("review_url")
  requestedAt          DateTime  @default(now()) @map("requested_at")
  clickedAt            DateTime? @map("clicked_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location    BusinessLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  submission  FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  submissions ReviewSubmission[]

  @@map("review_requests")
}

model ReviewSubmission {
  id               String    @id @default(uuid())
  businessId       String    @map("business_id")
  reviewRequestId  String    @map("review_request_id")
  platform         String    @default("google")
  status           String    @default("submitted")
  externalReviewId String?   @map("external_review_id")
  submittedAt      DateTime? @map("submitted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  request ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)

  @@map("review_submissions")
}

model GeneratedReview {
  id                   String   @id @default(uuid())
  businessId           String   @map("business_id")
  feedbackSubmissionId String   @map("feedback_submission_id")
  customerId           String?  @map("customer_id")
  provider             String   @default("gemini")
  model                String   @default("gemini-1.5-flash")
  promptVersion        String?  @map("prompt_version")
  reviewText           String   @map("review_text") @db.Text
  rating               Int
  status               String   @default("generated")
  tokenUsage           Json?    @map("token_usage")
  createdAt            DateTime @default(now()) @map("created_at")

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  submission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("generated_reviews")
}

model GoogleIntegration {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  locationId      String?  @map("location_id")
  googleAccountId String   @map("google_account_id")
  accessToken     String   @map("access_token") @db.Text
  refreshToken    String   @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime @map("token_expires_at")
  scopes          Json?
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@map("google_integrations")
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Decimal  @map("price_monthly")
  priceYearly  Decimal  @map("price_yearly")
  currency     String   @default("USD")
  limits       Json?
  features     Json?
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String   @id @default(uuid())
  businessId             String   @map("business_id")
  planId                 String   @map("plan_id")
  provider               String
  providerSubscriptionId String   @map("provider_subscription_id")
  status                 String
  currentPeriodStart     DateTime @map("current_period_start")
  currentPeriodEnd       DateTime @map("current_period_end")
  cancelAtPeriodEnd      Boolean  @default(false) @map("cancel_at_period_end")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  business          Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan              Plan               @relation(fields: [planId], references: [id])
  payments          Payment[]
  couponRedemptions CouponRedemption[]

  @@map("subscriptions")
}

model Payment {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  subscriptionId    String?   @map("subscription_id")
  provider          String
  providerPaymentId String    @map("provider_payment_id")
  amount            Decimal
  currency          String    @default("USD")
  status            String
  metadata          Json?
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model UsageRecord {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  metric      String
  quantity    Int
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, periodStart, periodEnd])
  @@map("usage_records")
}

model AuditLog {
  id           String   @id @default(uuid())
  traceId      String   @unique @default(dbgenerated("concat('AUD-', replace(cast(gen_random_uuid() as text), '-', ''))")) @map("trace_id")
  
  actorType    String   @default("superadmin") @map("actor_type") // superadmin, system, business_owner, etc.
  actorId      String?  @map("actor_id") // The User ID

  action       String
  
  resourceType String   @map("resource_type") // e.g., 'business', 'subscription'
  resourceId   String?  @map("resource_id") // e.g., biz_123
  businessId   String?  @map("business_id")
  
  description  String?
  result       String   @default("success") // success | warning | failed
  
  beforeData   Json?    @map("before_data")
  afterData    Json?    @map("after_data")
  metadata     Json?    // Optional for backwards compatibility
  
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  sessionId    String?  @map("session_id")
  
  createdAt    DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@index([traceId])
  @@index([resourceType, resourceId])
  @@index([businessId])
  @@index([createdAt])

  @@map("audit_logs")
}

model LegalPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  status    String   @default("published") // published/draft
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_pages")
}

model Coupon {
  id               String    @id @default(uuid())
  code             String    @unique
  type             String // "percentage" | "fixed"
  value            Decimal // Either % (e.g. 50) or fixed amt (e.g. 200)
  appliesTo        Json // Array of Plan IDs or ["all"]
  billingCycle     String // "monthly" | "yearly" | "both"
  maxRedemptions   Int?      @map("max_redemptions")
  usedRedemptions  Int       @default(0) @map("used_redemptions")
  perCustomer      Int       @default(1) @map("per_customer")
  validFrom        DateTime  @map("valid_from")
  validUntil       DateTime? @map("valid_until")
  minPurchase      Decimal?  @map("min_purchase")
  duration         String // "first_payment" | "first_n_months" | "forever"
  durationInMonths Int?      @map("duration_months") // If "first_n_months"
  status           String    @default("active") // "active", "disabled", "expired"
  createdAt        DateTime  @default(now()) @map("created_at")
  updatedAt        DateTime  @updatedAt @map("updated_at")

  redemptions CouponRedemption[]

  @@map("coupons")
}

model CouponRedemption {
  id             String   @id @default(uuid())
  couponId       String   @map("coupon_id")
  businessId     String   @map("business_id")
  subscriptionId String?  @map("subscription_id")
  discountAmount Decimal  @map("discount_amount")
  redeemedAt     DateTime @default(now()) @map("redeemed_at")

  coupon       Coupon        @relation(fields: [couponId], references: [id], onDelete: Cascade)
  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: SetNull)

  @@map("coupon_redemptions")
}

// --- SECURITY & SOC MODELS ---

model AdminSession {
  id           String   @id @default(uuid())
  userId       String   @map("user_id")
  ipAddress    String?  @map("ip_address")
  userAgent    String?  @map("user_agent")
  status       String   @default("active") // active/revoked
  lastActiveAt DateTime @default(now()) @map("last_active_at")
  createdAt    DateTime @default(now()) @map("created_at")

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("admin_sessions")
}

model SecurityEvent {
  id        String   @id @default(uuid())
  email     String?
  userId    String?  @map("user_id")
  event     String   // Failed Login, Locked Account, Suspicious IP
  ipAddress String?  @map("ip_address")
  userAgent String?  @map("user_agent")
  status    String   // Failed, Locked, Suspicious
  createdAt DateTime @default(now()) @map("created_at")

  user User? @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("security_events")
}

model BlockedIP {
  id        String   @id @default(uuid())
  ipAddress String   @unique @map("ip_address")
  reason    String?
  status    String   @default("blocked") // blocked/unblocked
  blockedAt DateTime @default(now()) @map("blocked_at")

  @@map("blocked_ips")
}

model SecuritySetting {
  id                     String  @id @default(uuid())
  
  // Auth
  admin2faEnabled        Boolean @default(false)
  sessionTimeout         Int     @default(30)
  maxLoginAttempts       Int     @default(5)
  accountLockDuration    Int     @default(15)

  // Login Sec
  loginNotification      Boolean @default(true)
  newDeviceNotification  Boolean @default(true)
  suspiciousLoginDetect  Boolean @default(true)

  // Session
  maxConcurrentSessions  Int     @default(3)
  revokeOnPasswordChange Boolean @default(true)

  // System Wide (Lockdown)
  lockdownEnabled        Boolean @default(false)
  
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("security_settings")
}

model FaqArticle {
  id        String   @id @default(uuid())
  title     String
  content   String   @db.Text
  category  String   @default("general")
  status    String   @default("published") // published/draft
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("faq_articles")
}

model PlatformSetting {
  id        String   @id @default(uuid())
  key       String   @unique
  value     Json
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("platform_settings")
}

