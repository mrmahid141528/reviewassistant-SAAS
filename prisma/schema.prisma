generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model User {
  id            String    @id @default(uuid())
  name          String?
  email         String?   @unique
  emailVerified DateTime? @map("email_verified")
  image         String?
  status        String    @default("active") // active/suspended/deleted
  createdAt     DateTime  @default(now()) @map("created_at")
  updatedAt     DateTime  @updatedAt @map("updated_at")

  accounts      Account[]
  sessions      Session[]
  memberships   BusinessMember[]

  @@map("users")
}

model Account {
  id                String  @id @default(uuid())
  userId            String  @map("user_id")
  type              String?
  provider          String
  providerAccountId String  @map("provider_account_id")
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@map("accounts")
}

model Session {
  id           String   @id @default(uuid())
  sessionToken String   @unique @map("session_token")
  userId       String   @map("user_id")
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("sessions")
}

model Business {
  id         String   @id @default(uuid())
  name       String
  slug       String   @unique
  logoUrl    String?  @map("logo_url")
  websiteUrl String?  @map("website_url")
  phone      String?
  email      String?
  timezone   String?
  status     String   @default("active")
  createdAt  DateTime @default(now()) @map("created_at")
  updatedAt  DateTime @updatedAt @map("updated_at")

  razorpayCustomerId       String?   @map("razorpay_customer_id")
  razorpaySubscriptionId   String?   @map("razorpay_subscription_id")
  razorpayPlanId           String?   @map("razorpay_plan_id")
  razorpayCurrentPeriodEnd DateTime? @map("razorpay_current_period_end")

  members             BusinessMember[]
  locations           BusinessLocation[]
  customers           Customer[]
  campaigns           Campaign[]
  feedbackSubmissions FeedbackSubmission[]
  reviewRequests      ReviewRequest[]
  generatedReviews    GeneratedReview[]
  googleIntegrations  GoogleIntegration[]
  subscriptions       Subscription[]
  payments            Payment[]
  usageRecords        UsageRecord[]
  auditLogs           AuditLog[]

  @@map("businesses")
}

model BusinessMember {
  id         String   @id @default(uuid())
  businessId String   @map("business_id")
  userId     String   @map("user_id")
  role       String   @default("staff") // owner/admin/manager/staff
  status     String   @default("invited")
  joinedAt   DateTime? @map("joined_at")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  user     User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([businessId, userId])
  @@map("business_members")
}

model BusinessLocation {
  id               String   @id @default(uuid())
  businessId       String   @map("business_id")
  name             String
  address          String?
  city             String?
  state            String?
  country          String?
  postalCode       String?  @map("postal_code")
  phone            String?
  googlePlaceId    String?  @map("google_place_id")
  googleBusinessId String?  @map("google_business_id")
  status           String   @default("active")
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  business           Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  customers          Customer[]
  campaigns          Campaign[]
  reviewRequests     ReviewRequest[]
  googleIntegrations GoogleIntegration[]

  @@map("business_locations")
}

model Customer {
  id                String   @id @default(uuid())
  businessId        String   @map("business_id")
  locationId        String?  @map("location_id")
  name              String?
  email             String?
  phone             String?
  externalReference String?  @map("external_reference")
  metadata          Json?
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  business           Business            @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location           BusinessLocation?   @relation(fields: [locationId], references: [id])
  feedbackSubmissions FeedbackSubmission[]
  reviewRequests     ReviewRequest[]
  generatedReviews   GeneratedReview[]

  @@map("customers")
}

model Campaign {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  locationId      String?  @map("location_id")
  name            String
  slug            String
  status          String   @default("active")
  ratingThreshold Int      @map("rating_threshold") @default(4)
  reviewPlatform  String   @map("review_platform") @default("google")
  settings        Json?
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business            Business             @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location            BusinessLocation?    @relation(fields: [locationId], references: [id], onDelete: SetNull)
  questions           CampaignQuestion[]
  feedbackSubmissions FeedbackSubmission[]

  @@map("campaigns")
}

model CampaignQuestion {
  id           String   @id @default(uuid())
  campaignId   String   @map("campaign_id")
  question     String
  questionType String   @map("question_type") // rating, text, etc
  options      Json?
  required     Boolean  @default(true)
  sortOrder    Int      @default(0) @map("sort_order")
  createdAt    DateTime @default(now()) @map("created_at")

  campaign     Campaign         @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  answers      FeedbackAnswer[]

  @@map("campaign_questions")
}

model FeedbackSubmission {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  campaignId  String   @map("campaign_id")
  customerId  String?  @map("customer_id")
  rating      Int
  status      String   @default("completed")
  source      String?
  submittedAt DateTime @default(now()) @map("submitted_at")
  createdAt   DateTime @default(now()) @map("created_at")

  business    Business        @relation(fields: [businessId], references: [id], onDelete: Cascade)
  campaign    Campaign        @relation(fields: [campaignId], references: [id], onDelete: Cascade)
  customer    Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  answers     FeedbackAnswer[]
  reviews     GeneratedReview[]
  requests    ReviewRequest[]

  @@map("feedback_submissions")
}

model FeedbackAnswer {
  id                   String   @id @default(uuid())
  feedbackSubmissionId String   @map("feedback_submission_id")
  questionId           String   @map("question_id")
  answerText           String?  @map("answer_text")
  answerValue          Json?    @map("answer_value")
  createdAt            DateTime @default(now()) @map("created_at")

  submission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  question   CampaignQuestion   @relation(fields: [questionId], references: [id])

  @@map("feedback_answers")
}

model ReviewRequest {
  id                   String    @id @default(uuid())
  businessId           String    @map("business_id")
  locationId           String    @map("location_id")
  customerId           String?   @map("customer_id")
  feedbackSubmissionId String    @map("feedback_submission_id")
  platform             String    @default("google")
  status               String    @default("pending")
  reviewUrl            String?   @map("review_url")
  requestedAt          DateTime  @default(now()) @map("requested_at")
  clickedAt            DateTime? @map("clicked_at")
  completedAt          DateTime? @map("completed_at")
  createdAt            DateTime  @default(now()) @map("created_at")

  business    Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location    BusinessLocation   @relation(fields: [locationId], references: [id], onDelete: Cascade)
  customer    Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)
  submission  FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  submissions ReviewSubmission[]

  @@map("review_requests")
}

model ReviewSubmission {
  id               String    @id @default(uuid())
  businessId       String    @map("business_id")
  reviewRequestId  String    @map("review_request_id")
  platform         String    @default("google")
  status           String    @default("submitted")
  externalReviewId String?   @map("external_review_id")
  submittedAt      DateTime? @map("submitted_at")
  createdAt        DateTime  @default(now()) @map("created_at")

  request ReviewRequest @relation(fields: [reviewRequestId], references: [id], onDelete: Cascade)

  @@map("review_submissions")
}

model GeneratedReview {
  id                   String   @id @default(uuid())
  businessId           String   @map("business_id")
  feedbackSubmissionId String   @map("feedback_submission_id")
  customerId           String?  @map("customer_id")
  provider             String   @default("gemini")
  model                String   @default("gemini-1.5-flash")
  promptVersion        String?  @map("prompt_version")
  reviewText           String   @db.Text @map("review_text")
  rating               Int
  status               String   @default("generated")
  tokenUsage           Json?    @map("token_usage")
  createdAt            DateTime @default(now()) @map("created_at")

  business   Business           @relation(fields: [businessId], references: [id], onDelete: Cascade)
  submission FeedbackSubmission @relation(fields: [feedbackSubmissionId], references: [id], onDelete: Cascade)
  customer   Customer?          @relation(fields: [customerId], references: [id], onDelete: SetNull)

  @@map("generated_reviews")
}

model GoogleIntegration {
  id              String   @id @default(uuid())
  businessId      String   @map("business_id")
  locationId      String?  @map("location_id")
  googleAccountId String   @map("google_account_id")
  accessToken     String   @map("access_token") @db.Text
  refreshToken    String   @map("refresh_token") @db.Text
  tokenExpiresAt  DateTime @map("token_expires_at")
  scopes          Json?
  status          String   @default("active")
  createdAt       DateTime @default(now()) @map("created_at")
  updatedAt       DateTime @updatedAt @map("updated_at")

  business Business          @relation(fields: [businessId], references: [id], onDelete: Cascade)
  location BusinessLocation? @relation(fields: [locationId], references: [id], onDelete: SetNull)

  @@map("google_integrations")
}

model Plan {
  id           String   @id @default(uuid())
  name         String
  slug         String   @unique
  description  String?
  priceMonthly Decimal  @map("price_monthly")
  priceYearly  Decimal  @map("price_yearly")
  currency     String   @default("USD")
  limits       Json?
  features     Json?
  status       String   @default("active")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  subscriptions Subscription[]

  @@map("plans")
}

model Subscription {
  id                     String   @id @default(uuid())
  businessId             String   @map("business_id")
  planId                 String   @map("plan_id")
  provider               String
  providerSubscriptionId String   @map("provider_subscription_id")
  status                 String
  currentPeriodStart     DateTime @map("current_period_start")
  currentPeriodEnd       DateTime @map("current_period_end")
  cancelAtPeriodEnd      Boolean  @default(false) @map("cancel_at_period_end")
  createdAt              DateTime @default(now()) @map("created_at")
  updatedAt              DateTime @updatedAt @map("updated_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)
  plan     Plan     @relation(fields: [planId], references: [id])
  payments Payment[]

  @@map("subscriptions")
}

model Payment {
  id                String    @id @default(uuid())
  businessId        String    @map("business_id")
  subscriptionId    String?   @map("subscription_id")
  provider          String
  providerPaymentId String    @map("provider_payment_id")
  amount            Decimal
  currency          String    @default("USD")
  status            String
  metadata          Json?
  paidAt            DateTime? @map("paid_at")
  createdAt         DateTime  @default(now()) @map("created_at")

  business     Business      @relation(fields: [businessId], references: [id], onDelete: Cascade)
  subscription Subscription? @relation(fields: [subscriptionId], references: [id], onDelete: Cascade)

  @@map("payments")
}

model UsageRecord {
  id          String   @id @default(uuid())
  businessId  String   @map("business_id")
  metric      String
  quantity    Int
  periodStart DateTime @map("period_start")
  periodEnd   DateTime @map("period_end")
  metadata    Json?
  createdAt   DateTime @default(now()) @map("created_at")

  business Business @relation(fields: [businessId], references: [id], onDelete: Cascade)

  @@index([businessId, periodStart, periodEnd])
  @@map("usage_records")
}

model AuditLog {
  id         String   @id @default(uuid())
  businessId String?  @map("business_id")
  userId     String?  @map("user_id")
  action     String
  entityType String   @map("entity_type")
  entityId   String?  @map("entity_id")
  metadata   Json?
  ipAddress  String?  @map("ip_address")
  userAgent  String?  @map("user_agent")
  createdAt  DateTime @default(now()) @map("created_at")

  business Business? @relation(fields: [businessId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
}

model LegalPage {
  id        String   @id @default(uuid())
  slug      String   @unique
  title     String
  content   String   @db.Text
  status    String   @default("published") // published/draft
  createdAt DateTime @default(now()) @map("created_at")
  updatedAt DateTime @updatedAt @map("updated_at")

  @@map("legal_pages")
}
